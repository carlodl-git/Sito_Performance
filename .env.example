# ============================================================
# Variabili d'ambiente. Copiare in .env.local per lo sviluppo,
# e impostare le stesse su Vercel per la produzione.
# ============================================================

# ID della property Google Analytics 4.
# Il vecchio WordPress usava G-5SB29CK9V0: riusare la stessa property
# mantiene la continuità storica dei dati attraverso la migrazione, che
# è l'unico modo per accorgersi di un calo di traffico dopo il cambio.
# Da confermare col centro prima del lancio.
#
# Se la variabile non è impostata, Analytics non viene mai caricato: il
# banner continua a funzionare e il sito resta senza cookie di analisi.
NEXT_PUBLIC_GA_ID=
